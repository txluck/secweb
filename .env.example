# secweb config
# 修改后重启服务生效

# Web 登录密码
SECWEB_PASSWORD=changeme

# 监听地址 / 端口
SECWEB_HOST=127.0.0.1
SECWEB_PORT=8765

# 默认并发数
SECWEB_DEFAULT_CONCURRENCY=3

# 默认 skill / prompt 模板。{url} 会被替换为目标
# 授权书由后端在每个任务 CWD 写入 CLAUDE.md,claude 启动会自发现,无需 prompt 再读
# prompt 末尾不要带"回复明白"等自然语言收尾,否则模型会在执行 /hack 前提早 end_turn
SECWEB_DEFAULT_PROMPT=/hack {url} auto

# claude CLI 路径
SECWEB_CLAUDE_BIN=/usr/local/bin/claude

# 单任务最长运行秒数 (0 = 不限制)
SECWEB_TASK_TIMEOUT=0

# Anthropic API (claude-agent-sdk 用)
#
# 设计: secweb 独立于本地 shell, ANTHROPIC_* 完全由 .env 决定.
# 你本地 ccswitch / .zshrc 切来切去是给交互式 CLI 用的, 跟 secweb 无关.
#   - 这里填值 → 立即生效, 启动时自动清父 shell 同名 env.
#   - 这里留空 → SDK 走 ~/.claude/ 默认认证 (CLI 留存 token).
#
# 用 Anthropic 官方留空 BASE_URL. 自建网关 / 中转填对应 URL:
#   ANTHROPIC_BASE_URL=https://your-gateway.example.com
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# 可选: 指定模型. 留空则 SDK 用 'claude_code' preset 默认
# 例: claude-opus-4-7[1M] / claude-sonnet-4-6 / claude-haiku-4-5 / gpt-5.5
ANTHROPIC_MODEL=
