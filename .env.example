# secweb config
# 修改后重启服务生效

# Web 登录密码
SECWEB_PASSWORD=changeme

# 监听地址 / 端口
SECWEB_HOST=127.0.0.1
SECWEB_PORT=8765

# 默认并发数
SECWEB_DEFAULT_CONCURRENCY=3

# 默认 skill / prompt 模板。{url} 会被替换为目标
# 授权书由后端在每个任务 CWD 写入 CLAUDE.md,claude 启动会自发现,无需 prompt 再读
# prompt 末尾不要带"回复明白"等自然语言收尾,否则模型会在执行 /hack 前提早 end_turn
SECWEB_DEFAULT_PROMPT=/hack {url} auto

# claude CLI 路径
SECWEB_CLAUDE_BIN=/usr/local/bin/claude

# 单任务最长运行秒数 (0 = 不限制)
SECWEB_TASK_TIMEOUT=0

# Anthropic API (claude-agent-sdk 用) — 优先级: .env 有值优先, 无值走父 env
#   1. 这里填值                          → 立即生效, 覆盖任何 shell export
#   2. 留空 + 父进程已 export ANTHROPIC_*  → 保留父 env (兼容 ccswitch 等切换器)
#   3. 都留空                            → SDK 走 ~/.claude/ 默认认证 (CLI 留存 token)
#
# 留空走 Anthropic 官方 API. 用自建网关 / 中转时填对应 URL:
#   ANTHROPIC_BASE_URL=https://your-gateway.example.com
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# 可选: 指定模型. 留空则 SDK 用 'claude_code' preset 默认
# 例: claude-opus-4-7[1M] / claude-sonnet-4-6 / claude-haiku-4-5
ANTHROPIC_MODEL=
